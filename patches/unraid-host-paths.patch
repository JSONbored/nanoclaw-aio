+/**
+ * Translate paths inside the AIO container to paths the host Docker daemon can
+ * see. Unraid mounts `/mnt/user/appdata/nanoclaw-aio` into the AIO container as
+ * `/appdata`, but nested agent containers are created by the host daemon through
+ * `/var/run/docker.sock`; those bind mounts must therefore use host paths.
+ */
+export function hostMountPath(containerPath: string): string {
+  const hostAppdata = process.env.NANOCLAW_HOST_APPDATA_DIR?.trim();
+  if (!hostAppdata) return containerPath;
+
+  const containerAppdata = path.resolve(process.env.NANOCLAW_CONTAINER_APPDATA_DIR || '/appdata');
+  const resolved = path.resolve(containerPath);
+  if (resolved === containerAppdata) {
+    return hostAppdata;
+  }
+  if (resolved.startsWith(`${containerAppdata}${path.sep}`)) {
+    return path.join(hostAppdata, path.relative(containerAppdata, resolved));
+  }
+  return containerPath;
+}
+
+export function volumeMountArgs(hostPath: string, containerPath: string, readonly = false): string[] {
+  const suffix = readonly ? ':ro' : '';
+  return ['-v', `${hostMountPath(hostPath)}:${containerPath}${suffix}`];
+}
+
 /** Returns CLI args for a readonly bind mount. */
 export function readonlyMountArgs(hostPath: string, containerPath: string): string[] {
-  return ['-v', `${hostPath}:${containerPath}:ro`];
+  return volumeMountArgs(hostPath, containerPath, true);
